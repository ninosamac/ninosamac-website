---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>&copy; {year} {SITE_TITLE}</p>
    <ul>
      {
        SOCIAL_LINKS.map((link) => (
          <li>
            <a href={link.href} rel="me">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-footer ul {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
