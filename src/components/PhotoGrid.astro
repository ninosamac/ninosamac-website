---
import CldImage from './CldImage.astro';
import { cldUrl } from '../lib/cloudinary';

interface Photo {
  id: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<ul class="photo-grid">
  {
    photos.map((photo, index) => (
      <li>
        <button
          type="button"
          class="photo-grid__item"
          data-index={index}
          data-full={cldUrl(photo.id, { width: 2000 })}
          data-alt={photo.alt}
          aria-label={`Open photo: ${photo.alt}`}
        >
          <CldImage
            id={photo.id}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            sizes="(min-width: 60rem) 20rem, 45vw"
          />
        </button>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" aria-label="Photo viewer">
  <button class="lightbox__close" type="button" aria-label="Close">&times;</button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Previous photo">
    &#8249;
  </button>
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" />
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Next photo">
    &#8250;
  </button>
</dialog>

<style>
  .photo-grid {
    columns: 3 15rem;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .photo-grid li {
    margin-bottom: 0.75rem;
    break-inside: avoid;
  }

  .photo-grid__item {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
  }

  .photo-grid__item :global(img) {
    border-radius: var(--radius);
    transition: filter 0.15s ease;
  }

  .photo-grid__item:hover :global(img) {
    filter: brightness(1.05);
  }

  @media (max-width: 40rem) {
    .photo-grid {
      columns: 2 8rem;
    }
  }

  /* Lightbox ------------------------------------------------------ */

  .lightbox {
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__figure {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 92vw;
    max-height: 92vh;
    margin: 0;
  }

  .lightbox__img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 86vh;
    margin: 0 auto;
    object-fit: contain;
  }

  .lightbox__caption {
    color: #d4d4d4;
    font-size: 0.85rem;
    text-align: center;
  }

  .lightbox__close,
  .lightbox__nav {
    position: fixed;
    background: none;
    border: 0;
    color: #fff;
    opacity: 0.8;
    cursor: pointer;
  }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    opacity: 1;
  }

  .lightbox__close {
    top: 1rem;
    right: 1.25rem;
    font-size: 2rem;
    line-height: 1;
  }

  .lightbox__nav {
    top: 50%;
    padding: 0.5rem 1rem;
    font-size: 3rem;
    transform: translateY(-50%);
  }

  .lightbox__nav--prev {
    left: 0.5rem;
  }

  .lightbox__nav--next {
    right: 0.5rem;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const items = [...document.querySelectorAll<HTMLButtonElement>('.photo-grid__item')];

  if (dialog && items.length > 0) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    let index = 0;

    const show = (next: number) => {
      index = (next + items.length) % items.length;
      const { full = '', alt = '' } = items[index].dataset;
      img.src = full;
      img.alt = alt;
      caption.textContent = alt;
    };

    items.forEach((button, i) =>
      button.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );

    dialog
      .querySelector<HTMLButtonElement>('.lightbox__close')!
      .addEventListener('click', () => dialog.close());
    dialog
      .querySelector<HTMLButtonElement>('.lightbox__nav--prev')!
      .addEventListener('click', () => show(index - 1));
    dialog
      .querySelector<HTMLButtonElement>('.lightbox__nav--next')!
      .addEventListener('click', () => show(index + 1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      else if (event.key === 'ArrowRight') show(index + 1);
    });
  }
</script>
