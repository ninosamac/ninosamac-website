---
import type { CollectionEntry } from 'astro:content';
import CldImage from './CldImage.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
  trip: CollectionEntry<'travel'>;
}

const { trip } = Astro.props;
const { title, location, date, cover } = trip.data;
---

<article class="trip-card">
  <a href={`/travel/${trip.id}/`}>
    <CldImage
      id={cover}
      alt={title}
      width={1200}
      height={800}
      crop="fill"
      gravity="auto"
      sizes="(min-width: 50rem) 24rem, 100vw"
    />
    <div class="trip-card__body">
      <h2>{title}</h2>
      <p class="trip-card__meta">{location} · <FormattedDate date={date} /></p>
    </div>
  </a>
</article>

<style>
  .trip-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .trip-card:hover {
    border-color: var(--accent);
  }

  .trip-card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .trip-card__body {
    padding: 0.9rem 1.1rem 1.1rem;
  }

  .trip-card__body h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .trip-card__meta {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
