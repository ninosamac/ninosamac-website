---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';

const recipes = (await getCollection('recipes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const tags = [...new Set(recipes.flatMap((recipe) => recipe.data.tags))].sort();
---

<BaseLayout title="Recipes" description="Recipes worth cooking twice.">
  <div class="prose">
    <h1>Recipes</h1>
    <p>Food worth cooking twice — with the quantities I actually use.</p>
  </div>

  {
    tags.length > 0 && (
      <nav class="tag-filter" aria-label="Filter recipes by tag">
        {tags.map((tag) => (
          <a href={`/recipes/tags/${tag}/`}>#{tag}</a>
        ))}
      </nav>
    )
  }

  {
    recipes.length === 0 ? (
      <p>No recipes yet.</p>
    ) : (
      <ul class="recipe-grid">
        {recipes.map((recipe) => (
          <li>
            <RecipeCard recipe={recipe} />
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
